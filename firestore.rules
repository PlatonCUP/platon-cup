rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }

    // 管理者用の合言葉。誰も読めない（管理者だけ読める）。最初の1回だけ作成でき、以後は管理者だけが作り直せる
    match /secret/admin {
      allow read: if isAdmin();
      allow create: if signedIn() && !exists(/databases/$(database)/documents/secret/admin);
      allow update: if isAdmin();
    }
    // 合言葉が一致した端末だけ管理者として登録できる
    match /admins/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.token == get(/databases/$(database)/documents/secret/admin).data.token;
      allow delete: if isAdmin();
    }
    // 大会の記録と結果：誰でも読める。書き込みは管理者だけ
    match /tournaments/{tid} {
      allow read: if true;
      allow write: if isAdmin();
      match /results/{rid} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }
    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
